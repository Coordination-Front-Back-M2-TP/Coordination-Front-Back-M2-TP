generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model CanvasState {
  id       Int @id @default(1)
  revision Int @default(0)
}

model Pixel {
  x         Int
  y         Int
  color     String
  updatedAt DateTime
  revision  Int      @unique

  @@id([x, y])
  @@index([y, x])
}

model PixelPlacement {
  id        Int      @id @default(autoincrement())
  accountId String
  teamId    String
  x         Int
  y         Int
  color     String
  placedAt  DateTime
  revision  Int      @unique

  @@index([placedAt])
}
