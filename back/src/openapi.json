{
  "openapi": "3.0.3",
  "info": {
    "title": "API P1X3L",
    "version": "0.1.0",
    "description": "API REST du projet P1X3L (pixel war en temps réel). Documente le contrat entre le front-end React et le back-end Node.js."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Serveur local de développement"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Vérifier l'état et la version du back-end",
        "description": "Permet au front et aux outils de surveillance de vérifier que l'API répond et d'identifier la version déployée.",
        "responses": {
          "200": {
            "description": "API opérationnelle",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok",
                  "version": "dev"
                }
              }
            }
          },
          "500": {
            "description": "Erreur interne du serveur",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "INTERNAL_SERVER_ERROR",
                    "message": "Une erreur inattendue est survenue."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/pixels": {
      "get": {
        "summary": "Lire l'état courant de la toile",
        "description": "Lecture publique sans authentification. La toile est représentée par les pixels présents uniquement ; les coordonnées sont centrées sur (0, 0).",
        "responses": {
          "200": {
            "description": "Instantané courant de la toile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CanvasSnapshot"
                }
              }
            }
          },
          "500": {
            "description": "Toile momentanément indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Poser un pixel",
        "description": "Pose un pixel sur la toile au nom du compte connecté. Requiert une session authentifiée : en attendant le contrat d'authentification de l'issue #18, un placeholder transmet la session par l'en-tête `X-Session-Id` (proposition à valider). Chaque pose acceptée est enregistrée dans l'historique avec le compte, l'équipe et l'heure serveur ; l'historique n'est jamais renvoyé. Le délai (`cooldownEndsAt`, durée démo de 10 secondes réglable côté serveur) est calculé mais pas encore contraignant : le rejet 429 est l'issue #46.",
        "parameters": [
          {
            "name": "X-Session-Id",
            "in": "header",
            "required": true,
            "description": "TEMPORAIRE : identifiant de session de démonstration, en attendant le mécanisme du contrat #18. Toute valeur non vide est acceptée ; sans en-tête, la réponse est 401.",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlacePixelRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pixel posé et enregistré",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlacePixelResponse"
                }
              }
            }
          },
          "400": {
            "description": "Coordonnées invalides ou couleur absente ou mal formée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "INVALID_INPUT",
                    "message": "Coordonnées ou couleur invalides."
                  }
                }
              }
            }
          },
          "401": {
            "description": "Aucune session valide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "UNAUTHORIZED",
                    "message": "Un compte connecté est nécessaire pour poser un pixel."
                  }
                }
              }
            }
          },
          "429": {
            "description": "Délai entre deux poses non écoulé. Prévu par le contrat mais pas encore appliqué : le rejet est l'issue #46.",
            "headers": {
              "Retry-After": {
                "description": "Secondes restantes avant la prochaine pose autorisée",
                "schema": { "type": "integer" }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "COOLDOWN_ACTIVE",
                    "message": "Délai actif, veuillez patienter."
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erreur interne du serveur",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CanvasSnapshot": {
        "type": "object",
        "required": ["width", "height", "revision", "snapshotAt", "pixels"],
        "properties": {
          "width": { "type": "integer", "example": 101 },
          "height": { "type": "integer", "example": 101 },
          "revision": { "type": "integer", "minimum": 0 },
          "snapshotAt": { "type": "string", "format": "date-time" },
          "pixels": {
            "type": "array",
            "maxItems": 10201,
            "items": { "$ref": "#/components/schemas/Pixel" }
          }
        }
      },
      "Pixel": {
        "type": "object",
        "required": ["x", "y", "color", "updatedAt", "revision"],
        "properties": {
          "x": { "type": "integer", "minimum": -50, "maximum": 50 },
          "y": { "type": "integer", "minimum": -50, "maximum": 50 },
          "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "revision": { "type": "integer", "minimum": 1 }
        }
      },
      "PlacePixelRequest": {
        "type": "object",
        "required": ["x", "y", "color"],
        "properties": {
          "x": { "type": "integer", "minimum": -50, "maximum": 50 },
          "y": { "type": "integer", "minimum": -50, "maximum": 50 },
          "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
        }
      },
      "PlacePixelResponse": {
        "type": "object",
        "required": ["pixel", "cooldownEndsAt"],
        "properties": {
          "pixel": { "$ref": "#/components/schemas/Pixel" },
          "cooldownEndsAt": {
            "type": "string",
            "format": "date-time",
            "description": "Heure serveur à laquelle le compte pourra poser à nouveau (durée démo de 10 secondes, réglable côté serveur)"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "État du serveur ('ok')",
            "example": "ok"
          },
          "version": {
            "type": "string",
            "description": "Commit ou identifiant de version déployé ('dev' hors Docker)",
            "example": "dev"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Code d'erreur machine en majuscules avec tirets bas",
                "example": "COOLDOWN_ACTIVE"
              },
              "message": {
                "type": "string",
                "description": "Message d'erreur explicatif en français à destination de l'utilisateur",
                "example": "Attends encore 12 secondes avant de poser un pixel."
              }
            }
          }
        }
      }
    }
  }
}
