{
  "openapi": "3.0.3",
  "info": {
    "title": "API P1X3L",
    "version": "0.1.0",
    "description": "API REST du projet P1X3L (pixel war en temps réel). Documente le contrat entre le front-end React et le back-end Node.js."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Serveur local de développement"
    }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "summary": "Créer un compte",
        "description": "Crée le compte et connecte le joueur. Le pseudo est unique sans tenir compte de la casse. Le mot de passe est stocké haché (scrypt), jamais en clair.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Compte créé, session ouverte",
            "headers": {
              "Set-Cookie": {
                "description": "Cookie de session p1x3l_session : HttpOnly, SameSite=Lax, Path=/, Secure en production.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Pseudo ou mot de passe hors des règles de saisie (INVALID_INPUT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Pseudo déjà pris (PSEUDO_TAKEN)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erreur inattendue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Se connecter",
        "description": "Ouvre une session. Un pseudo inconnu et un mot de passe incorrect reçoivent la même réponse.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session ouverte",
            "headers": {
              "Set-Cookie": {
                "description": "Cookie de session p1x3l_session : HttpOnly, SameSite=Lax, Path=/, Secure en production.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Pseudo ou mot de passe absent (INVALID_INPUT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Pseudo inconnu ou mot de passe incorrect (INVALID_CREDENTIALS)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erreur inattendue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "Se déconnecter",
        "description": "Supprime la session côté serveur et efface le cookie. Sans session, la réponse est la même.",
        "responses": {
          "204": {
            "description": "Session fermée"
          },
          "500": {
            "description": "Erreur inattendue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Retrouver le joueur connecté",
        "description": "Lit la session dans le cookie p1x3l_session. Le front l'appelle au chargement de la page.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Joueur connecté",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Aucune session valide (UNAUTHORIZED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erreur inattendue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Vérifier l'état et la version du back-end",
        "description": "Permet au front et aux outils de surveillance de vérifier que l'API répond et d'identifier la version déployée.",
        "responses": {
          "200": {
            "description": "API opérationnelle",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok",
                  "version": "dev"
                }
              }
            }
          },
          "500": {
            "description": "Erreur interne du serveur",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "INTERNAL_SERVER_ERROR",
                    "message": "Une erreur inattendue est survenue."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/pixels": {
      "get": {
        "summary": "Lire l'état courant de la toile",
        "description": "Lecture publique sans authentification. La toile est représentée par les pixels présents uniquement ; les coordonnées sont centrées sur (0, 0).",
        "responses": {
          "200": {
            "description": "Instantané courant de la toile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CanvasSnapshot"
                }
              }
            }
          },
          "500": {
            "description": "Toile momentanément indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Poser un pixel",
        "description": "Compte connecté requis. Le compte et l'équipe viennent de la session, jamais du corps. Chaque pose acceptée est inscrite dans l'historique (compte, équipe, heure serveur) puis diffusée par pixel:updated. Le serveur vérifie le délai du compte entre deux poses (10 secondes par défaut, PIXEL_COOLDOWN_SECONDS) ; cooldownEndsAt donne l'heure serveur de la prochaine pose possible. Le joueur est lu dans le cookie de session p1x3l_session ; tant qu'il n'a pas d'équipe (#41), sa pose est inscrite sans équipe.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "x",
                  "y",
                  "color"
                ],
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": -50,
                    "maximum": 50
                  },
                  "y": {
                    "type": "integer",
                    "minimum": -50,
                    "maximum": 50
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$",
                    "example": "#D93A3A"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pixel enregistré",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "pixel",
                    "cooldownEndsAt"
                  ],
                  "properties": {
                    "pixel": {
                      "$ref": "#/components/schemas/Pixel"
                    },
                    "cooldownEndsAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Coordonnées ou couleur invalides (INVALID_INPUT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Compte non connecté (UNAUTHORIZED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Le délai du compte n'est pas écoulé (COOLDOWN_ACTIVE). Rien n'est écrit.",
            "headers": {
              "Retry-After": {
                "description": "Temps restant avant la prochaine pose, en secondes entières, arrondi au-dessus.",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erreur inattendue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Credentials": {
        "type": "object",
        "required": [
          "pseudo",
          "password"
        ],
        "properties": {
          "pseudo": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{3,20}$",
            "example": "Alex"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "format": "password"
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "required": [
          "user"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "pseudo",
          "team"
        ],
        "properties": {
          "pseudo": {
            "type": "string",
            "example": "Alex"
          },
          "team": {
            "type": "object",
            "nullable": true,
            "description": "Équipe du joueur. Toujours null tant que les équipes (#41) ne sont pas livrées."
          }
        }
      },
      "CanvasSnapshot": {
        "type": "object",
        "required": [
          "width",
          "height",
          "revision",
          "snapshotAt",
          "pixels"
        ],
        "properties": {
          "width": {
            "type": "integer",
            "example": 101
          },
          "height": {
            "type": "integer",
            "example": 101
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "snapshotAt": {
            "type": "string",
            "format": "date-time"
          },
          "pixels": {
            "type": "array",
            "maxItems": 10201,
            "items": {
              "$ref": "#/components/schemas/Pixel"
            }
          }
        }
      },
      "Pixel": {
        "type": "object",
        "required": [
          "x",
          "y",
          "color",
          "updatedAt",
          "revision"
        ],
        "properties": {
          "x": {
            "type": "integer",
            "minimum": -50,
            "maximum": 50
          },
          "y": {
            "type": "integer",
            "minimum": -50,
            "maximum": 50
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "État du serveur ('ok')",
            "example": "ok"
          },
          "version": {
            "type": "string",
            "description": "Commit ou identifiant de version déployé ('dev' hors Docker)",
            "example": "dev"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Code d'erreur machine en majuscules avec tirets bas",
                "example": "COOLDOWN_ACTIVE"
              },
              "message": {
                "type": "string",
                "description": "Message d'erreur explicatif en français à destination de l'utilisateur",
                "example": "Attends encore 12 secondes avant de poser un pixel."
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "p1x3l_session"
      }
    }
  }
}
