{
  "openapi": "3.0.3",
  "info": {
    "title": "API P1X3L",
    "version": "0.1.0",
    "description": "API REST du projet P1X3L (pixel war en temps réel). Documente le contrat entre le front-end React et le back-end Node.js."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Serveur local de développement"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Vérifier l'état et la version du back-end",
        "description": "Permet au front et aux outils de surveillance de vérifier que l'API répond et d'identifier la version déployée.",
        "responses": {
          "200": {
            "description": "API opérationnelle",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok",
                  "version": "dev"
                }
              }
            }
          },
          "500": {
            "description": "Erreur interne du serveur",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "INTERNAL_SERVER_ERROR",
                    "message": "Une erreur inattendue est survenue."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/rankings": {
      "get": {
        "summary": "Lire le classement des équipes",
        "description": "Lecture publique sans authentification. Un pixel compte pour l'équipe qui l'a posé en dernier. Les équipes sont triées par nombre de pixels ; à égalité, elles ont le même rang. Une équipe sans pixel n'apparaît pas. Le même contenu est diffusé par ranking:updated aux abonnés de la toile quand le classement change.",
        "responses": {
          "200": {
            "description": "Classement courant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ranking"
                },
                "example": {
                  "revision": 185,
                  "teams": [
                    {
                      "teamId": "rouge",
                      "pixelCount": 42,
                      "rank": 1
                    },
                    {
                      "teamId": "bleue",
                      "pixelCount": 17,
                      "rank": 2
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Erreur inattendue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/pixels": {
      "get": {
        "summary": "Lire l'état courant de la toile",
        "description": "Lecture publique sans authentification. La toile est représentée par les pixels présents uniquement ; les coordonnées sont centrées sur (0, 0).",
        "responses": {
          "200": {
            "description": "Instantané courant de la toile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CanvasSnapshot"
                }
              }
            }
          },
          "500": {
            "description": "Toile momentanément indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Poser un pixel",
        "description": "Compte connecté requis. Le compte et l'équipe viennent de la session, jamais du corps. Chaque pose acceptée est inscrite dans l'historique (compte, équipe, heure serveur) puis diffusée par pixel:updated. Le serveur vérifie le délai du compte entre deux poses (10 secondes par défaut, PIXEL_COOLDOWN_SECONDS) ; cooldownEndsAt donne l'heure serveur de la prochaine pose possible. Tant que l'authentification (#18) n'est pas branchée, la route renvoie 401.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "x",
                  "y",
                  "color"
                ],
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": -50,
                    "maximum": 50
                  },
                  "y": {
                    "type": "integer",
                    "minimum": -50,
                    "maximum": 50
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$",
                    "example": "#D93A3A"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pixel enregistré",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "pixel",
                    "cooldownEndsAt"
                  ],
                  "properties": {
                    "pixel": {
                      "$ref": "#/components/schemas/Pixel"
                    },
                    "cooldownEndsAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Coordonnées ou couleur invalides (INVALID_INPUT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Compte non connecté (UNAUTHORIZED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Le délai du compte n'est pas écoulé (COOLDOWN_ACTIVE). Rien n'est écrit.",
            "headers": {
              "Retry-After": {
                "description": "Temps restant avant la prochaine pose, en secondes entières, arrondi au-dessus.",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erreur inattendue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/placements": {
      "get": {
        "summary": "Lire l'historique des poses par période",
        "description": "Lecture publique sans authentification, pour le timelapse. Les poses sont rendues dans l'ordre des révisions, y compris celles qu'une pose suivante a remplacées. Aucune pose ne contient de compte ni d'équipe. Sans from, l'historique part de la première pose de la toile.",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Début de la période, inclus. Date ISO 8601 avec fuseau.",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "example": "2026-10-27T14:00:00.000Z"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "Fin de la période, exclue. Date ISO 8601 avec fuseau.",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "example": "2026-10-27T15:00:00.000Z"
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "description": "Révision de la dernière pose déjà reçue (nextCursor de la page précédente).",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Nombre maximal de poses dans la page.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 500
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Une page de l'historique",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlacementPage"
                }
              }
            }
          },
          "400": {
            "description": "Période ou page invalide (INVALID_INPUT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erreur inattendue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CanvasSnapshot": {
        "type": "object",
        "required": [
          "width",
          "height",
          "revision",
          "snapshotAt",
          "pixels"
        ],
        "properties": {
          "width": {
            "type": "integer",
            "example": 101
          },
          "height": {
            "type": "integer",
            "example": 101
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "snapshotAt": {
            "type": "string",
            "format": "date-time"
          },
          "pixels": {
            "type": "array",
            "maxItems": 10201,
            "items": {
              "$ref": "#/components/schemas/Pixel"
            }
          }
        }
      },
      "Pixel": {
        "type": "object",
        "required": [
          "x",
          "y",
          "color",
          "updatedAt",
          "revision"
        ],
        "properties": {
          "x": {
            "type": "integer",
            "minimum": -50,
            "maximum": 50
          },
          "y": {
            "type": "integer",
            "minimum": -50,
            "maximum": 50
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "PlacementPage": {
        "type": "object",
        "required": [
          "placements",
          "nextCursor"
        ],
        "properties": {
          "placements": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/components/schemas/Placement"
            }
          },
          "nextCursor": {
            "type": "integer",
            "nullable": true,
            "description": "Valeur à passer dans after pour la page suivante ; null à la fin de la période."
          }
        }
      },
      "Placement": {
        "type": "object",
        "required": [
          "x",
          "y",
          "color",
          "placedAt",
          "revision"
        ],
        "properties": {
          "x": {
            "type": "integer",
            "minimum": -50,
            "maximum": 50
          },
          "y": {
            "type": "integer",
            "minimum": -50,
            "maximum": 50
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "placedAt": {
            "type": "string",
            "format": "date-time"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Ranking": {
        "type": "object",
        "required": [
          "revision",
          "teams"
        ],
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0,
            "description": "Révision de la toile au moment du calcul"
          },
          "teams": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "teamId",
                "pixelCount",
                "rank"
              ],
              "properties": {
                "teamId": {
                  "type": "string"
                },
                "pixelCount": {
                  "type": "integer",
                  "minimum": 1
                },
                "rank": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "État du serveur ('ok')",
            "example": "ok"
          },
          "version": {
            "type": "string",
            "description": "Commit ou identifiant de version déployé ('dev' hors Docker)",
            "example": "dev"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Code d'erreur machine en majuscules avec tirets bas",
                "example": "COOLDOWN_ACTIVE"
              },
              "message": {
                "type": "string",
                "description": "Message d'erreur explicatif en français à destination de l'utilisateur",
                "example": "Attends encore 12 secondes avant de poser un pixel."
              }
            }
          }
        }
      }
    }
  }
}
